{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cloud-genealogy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-22",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloud-genealogy-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cloud-genealogy-local"
    }
  ],
  "vars": {
    "APP_ENV": "development"
  },
  "env": {
    "preview": {
      "name": "cloud-genealogy-preview",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloud-genealogy-preview",
          "database_id": "11111111-1111-1111-1111-111111111111"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "cloud-genealogy-preview"
        }
      ],
      "vars": {
        "APP_ENV": "preview"
      }
    },
    "production": {
      "name": "cloud-genealogy-production",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cloud-genealogy-production",
          "database_id": "22222222-2222-2222-2222-222222222222"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "cloud-genealogy-production"
        }
      ],
      "vars": {
        "APP_ENV": "production"
      }
    }
  }
}
