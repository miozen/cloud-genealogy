{
  "name": "cloud-genealogy",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --local",
    "demo:local-chart": "bash scripts/demo-local-chart.sh",
    "verify:local-chart-demo": "LOCAL_CHART_DEMO_VERIFY_ONLY=1 bash scripts/demo-local-chart.sh",
    "demo:local-branch-workbench": "bash scripts/demo-local-branch-workbench.sh",
    "verify:local-branch-workbench-demo": "LOCAL_BRANCH_WORKBENCH_DEMO_VERIFY_ONLY=1 bash scripts/demo-local-branch-workbench.sh",
    "build": "npm run typecheck && vite build",
    "test": "vitest run",
    "test:local-auth": "bash scripts/test-local-auth.sh",
    "test:local-auth-crash-recovery": "node scripts/test-local-auth-crash-recovery.mjs",
    "test:local-backup-window": "node scripts/test-local-backup-window.mjs",
    "test:local-core-model": "bash scripts/test-local-core-model.sh",
    "test:local-chart-scale": "bash scripts/test-local-chart-scale.sh",
    "test:local-backup-recovery": "bash scripts/test-local-backup-recovery.sh",
    "collect:local-backup-counts": "node scripts/backup-counts.mjs",
    "crypt:backup": "node scripts/backup-crypt.mjs",
    "archive:local-backup": "node scripts/backup-local-archive.mjs",
    "catalog:backup-recovery": "node scripts/backup-recovery-catalog.mjs",
    "prepare:d1-restore-data": "node scripts/prepare-d1-restore-data.mjs",
    "preflight:remote-backup": "node scripts/remote-backup-preflight.mjs",
    "plan:remote-backup": "node scripts/remote-backup-command-plan.mjs",
    "precheck:remote-backup": "node scripts/remote-backup-execution-precheck.mjs",
    "validate:preview-recovery-authorization": "node scripts/validate-preview-recovery-authorization.mjs",
    "execute:preview-remote-backup": "node scripts/execute-preview-remote-backup.mjs",
    "test:preview-backup-mock": "node scripts/test-preview-backup-mock.mjs",
    "test:fencing-prototype": "node scripts/test-fencing-prototype.mjs",
    "test:cross-store-recovery-prototype": "node scripts/test-cross-store-recovery-prototype.mjs",
    "test:cross-store-persistence": "node scripts/test-cross-store-persistence.mjs",
    "test:remote-backup-preflight": "node scripts/test-remote-backup-preflight.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "vue-tsc --noEmit",
    "check": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "hono": "^4.13.13",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "@eslint/js": "^9.39.1",
    "@vitejs/plugin-vue": "^6.0.2",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.4",
    "wrangler": "^4.151.3"
  }
}
